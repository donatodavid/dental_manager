<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 360" width="100%" height="100%">
  <defs>
    <!-- Gold Border Gradient -->
    <linearGradient id="goldBorder" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E2B14C"/>
      <stop offset="25%" stop-color="#FFF3A8"/>
      <stop offset="50%" stop-color="#C6922C"/>
      <stop offset="75%" stop-color="#FFDF73"/>
      <stop offset="100%" stop-color="#8F6218"/>
    </linearGradient>

    <linearGradient id="goldInnerRing" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#9C6B1C"/>
      <stop offset="30%" stop-color="#FFEB8A"/>
      <stop offset="70%" stop-color="#BF8B28"/>
      <stop offset="100%" stop-color="#E6B850"/>
    </linearGradient>

    <!-- Teal Background Gradient -->
    <radialGradient id="tealBg" cx="50%" cy="50%" r="50%" fx="45%" fy="45%">
      <stop offset="0%" stop-color="#02A796"/>
      <stop offset="70%" stop-color="#008375"/>
      <stop offset="100%" stop-color="#006359"/>
    </radialGradient>

    <!-- Magenta Fill for Daaron -->
    <linearGradient id="magentaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#D9289E"/>
      <stop offset="50%" stop-color="#B31282"/>
      <stop offset="100%" stop-color="#8D0A66"/>
    </linearGradient>

    <!-- Drop Shadow Filter -->
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.4"/>
    </filter>

    <filter id="glowMagenta" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#FF63D8" flood-opacity="0.8"/>
    </filter>

    <filter id="whiteStroke">
      <feMorphology in="SourceAlpha" result="DILATED" operator="dilate" radius="4"/>
      <feFlood flood-color="#FFFFFF" result="WHITE"/>
      <feComposite in="WHITE" in2="DILATED" operator="in" result="OUTLINE"/>
      <feMerge>
        <feMergeNode in="OUTLINE"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Outer Golden Frame -->
  <ellipse cx="450" cy="180" rx="430" ry="165" fill="url(#goldBorder)" filter="url(#shadow)"/>
  <ellipse cx="450" cy="180" rx="412" ry="148" fill="url(#goldInnerRing)"/>
  
  <!-- Main Teal Inner Oval -->
  <ellipse cx="450" cy="180" rx="396" ry="136" fill="url(#tealBg)"/>

  <!-- Left Tooth Outline (Interlocking Yellow and Magenta Lines) -->
  <g transform="translate(145, 45)">
    <!-- Yellow Tooth Curve (Left) -->
    <path d="M 50,45 C 50,15 90,15 105,35 C 115,50 115,65 110,95 C 105,125 75,170 65,190 C 55,210 40,205 35,185 C 28,160 35,100 35,70 C 35,45 42,45 50,45 Z" 
          fill="none" stroke="#FFF799" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"
          filter="drop-shadow(0 0 6px rgba(255,247,153,0.8))"/>
    
    <!-- Magenta Tooth Crown / Root (Right) -->
    <path d="M 95,35 C 110,25 150,25 160,50 C 168,70 145,100 135,140 C 128,170 120,200 110,215 C 100,225 85,215 85,195 C 85,175 98,145 100,120 C 102,90 95,75 80,75 C 70,75 65,85 65,95" 
          fill="none" stroke="#FFFFFF" stroke-width="18" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M 95,35 C 110,25 150,25 160,50 C 168,70 145,100 135,140 C 128,170 120,200 110,215 C 100,225 85,215 85,195 C 85,175 98,145 100,120 C 102,90 95,75 80,75 C 70,75 65,85 65,95" 
          fill="none" stroke="#C026D3" stroke-width="12" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- Typography "Daaron" -->
  <!-- Stylized script with thick white outer stroke and magenta interior -->
  <g transform="translate(300, 205)">
    <!-- White Outline Layer -->
    <text x="0" y="0" font-family="'Comic Sans MS', 'Pacifico', 'Brush Script MT', 'Arial Rounded MT Bold', sans-serif" 
          font-size="140" font-weight="900" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="16" stroke-linejoin="round" 
          letter-spacing="-1">
      Daaron
    </text>
    <!-- Magenta Gradient Layer -->
    <text x="0" y="0" font-family="'Comic Sans MS', 'Pacifico', 'Brush Script MT', 'Arial Rounded MT Bold', sans-serif" 
          font-size="140" font-weight="900" fill="url(#magentaGrad)" letter-spacing="-1">
      Daaron
    </text>
  </g>

  <!-- Subtitle "CONSULTA DENTAL" -->
  <g transform="translate(450, 275)">
    <text x="0" y="0" text-anchor="middle" font-family="'Arial Black', 'Montserrat', 'Trebuchet MS', sans-serif" 
          font-size="34" font-weight="900" fill="#FFFFFF" stroke="#B31282" stroke-width="4" paint-order="stroke fill" letter-spacing="4"
          filter="drop-shadow(0 2px 4px rgba(0,0,0,0.5))">
      CONSULTA DENTAL
    </text>
  </g>
</svg>
